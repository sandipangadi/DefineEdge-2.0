# Copy this file to .env.shoonya (or env.shoonya on Windows).
# Keep it in the same folder as start_shoonya_relay_final.bat.
# Never upload your completed credential file or paste its values into chat.

SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=

# "auto" derives the desktop device ID from the local computer MAC.
# Replace only if Shoonya support gave you a specific device/IMEI value.
SHOONYA_IMEI=auto

COLLECTOR_PASSWORD=
RENDER_COLLECTOR_URL=https://definedge-momentum-batch-collector-v6.onrender.com
DATA_FROM_DATE=2026-02-25
DATA_TO_DATE=2026-05-18
LOOKBACK_DAYS=7
